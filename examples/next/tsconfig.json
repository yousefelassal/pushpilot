{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "es2022"],
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"allowJs": true,
		"incremental": true,
		"resolveJsonModule": true,
		"isolatedModules": true
	},
	"include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
