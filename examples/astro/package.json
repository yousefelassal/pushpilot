{
	"name": "@pushpilot/example-astro",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm sw && astro dev --port 3000",
		"build": "pnpm sw && astro build",
		"start": "node dist/server/entry.mjs",
		"sw": "esbuild src/sw.ts --bundle --format=iife --outfile=public/sw.js"
	},
	"dependencies": {
		"astro": "5.18.2",
		"@astrojs/node": "9.5.1",
		"pushpilot": "workspace:*"
	},
	"devDependencies": {
		"esbuild": "0.27.0"
	}
}
