{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src"]
}
