{
	"name": "@pushpilot/example-hono",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm bundle && tsx src/index.tsx",
		"build": "pnpm bundle",
		"start": "tsx src/index.tsx",
		"bundle": "pnpm sw && esbuild src/client.ts --bundle --format=esm --outfile=public/client.js",
		"sw": "esbuild src/sw.ts --bundle --format=iife --outfile=public/sw.js"
	},
	"dependencies": {
		"hono": "4.13.18",
		"@hono/node-server": "2.1.8",
		"pushpilot": "workspace:*"
	},
	"devDependencies": {
		"tsx": "4.20.6",
		"esbuild": "0.27.0"
	}
}
