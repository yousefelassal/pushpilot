{
	"name": "@pushpilot/example-react-router",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm sw && react-router dev --port 3000",
		"build": "pnpm sw && react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"sw": "esbuild app/sw.ts --bundle --format=iife --outfile=public/sw.js"
	},
	"dependencies": {
		"react-router": "7.18.5",
		"@react-router/node": "7.18.5",
		"@react-router/serve": "7.18.5",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"isbot": "5.1.31",
		"pushpilot": "workspace:*"
	},
	"devDependencies": {
		"@react-router/dev": "7.18.5",
		"vite": "6.4.1",
		"typescript": "5.9.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@types/node": "22.19.1",
		"esbuild": "0.27.0"
	}
}
