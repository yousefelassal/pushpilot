{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"strict": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["vite/client", "node"],
		"rootDirs": [".", "./.react-router/types"]
	},
	"include": ["app/**/*", "*.ts", ".react-router/types/**/*"]
}
