{
	"name": "pushpilot-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"build": "pnpm --filter pushpilot build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware --max-warnings=0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"docs:build": "pnpm --filter @pushpilot/docs build",
		"check:package": "pnpm --filter pushpilot check",
		"smoke": "node scripts/smoke.mjs",
		"changeset": "changeset",
		"smoke:workerd": "node scripts/workerd-smoke.mjs",
		"smoke:browser": "node scripts/browser-smoke.mjs",
		"check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm build && pnpm check:package && pnpm smoke && pnpm smoke:cli && pnpm smoke:workerd && pnpm docs:build",
		"smoke:cli": "node scripts/cli-smoke.mjs",
		"smoke:examples": "node scripts/examples-check.mjs",
		"lint:fix": "oxlint --type-aware --fix",
		"release": "pnpm build && changeset publish",
		"version-packages": "changeset version && pnpm install --lockfile-only"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@block65/webcrypto-web-push": "2.0.0",
		"@changesets/cli": "2.29.8",
		"@playwright/test": "1.56.1",
		"@types/node": "22.19.1",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"esbuild": "0.27.0",
		"miniflare": "4.20260730.0",
		"oxlint": "1.90.0",
		"prettier": "3.6.2",
		"publint": "0.3.15",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tsdown": "0.15.12",
		"typescript": "5.9.3",
		"vitest": "3.2.4",
		"oxlint-tsgolint": "7.0.2005"
	}
}
